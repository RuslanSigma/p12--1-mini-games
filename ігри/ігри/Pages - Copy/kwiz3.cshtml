@page
@model ігри.Pages.kwiz3Model
@{
}
<div class="quiz-container">
        <h1>Фізична вікторина</h1>
        <h2 id="question-number">Питання 1/10</h2>
        <p class="question" id="question-text">Що таке гравітація?</p>
        <form id="quiz-form">
            <div class="option-container">
                <div class="option">
                    <input type="radio" id="option1" name="answer" value="Сила, яка притягує об'єкти один до одного">
                    <label for="option1" id="label1">Сила, яка притягує об'єкти один до одного</label>
                </div>
                <div class="option">
                    <input type="radio" id="option2" name="answer" value="Сила, яка відштовхує об'єкти один від одного">
                    <label for="option2" id="label2">Сила, яка відштовхує об'єкти один від одного</label>
                </div>
                <div class="option">
                    <input type="radio" id="option3" name="answer" value="Сила, яка рухає об'єкти горизонтально">
                    <label for="option3" id="label3">Сила, яка рухає об'єкти горизонтально</label>
                </div>
            </div>
            <button type="button" onclick="submitAnswer()">Відповісти</button>
        </form>
        <div id="feedback" class="feedback"></div>
        <button type="button" id="next-button" style="display:none;" onclick="nextQuestion()">Далі</button>
        <div id="result" class="result" style="display:none;"></div>
    </div>
    <script>
        const questions = [
            {
                text: 'Що таке гравітація?',
                image: 'data:image/jpeg;base64,',
                options: ['Сила, яка притягує об\'єкти один до одного', 'Сила, яка відштовхує об\'єкти один від одного', 'Сила, яка рухає об\'єкти горизонтально'],
                correct: 'Сила, яка притягує об\'єкти один до одного'
            },
            {
                text: 'Як називається найменша частинка хімічного елемента?',
                image: '',
                options: ['Атом', 'Молекула', 'Електрон'],
                correct: 'Атом'
            },
            {
                text: 'Яка одиниця вимірювання електричного струму?',
                image: '',
                options: ['Вольт', 'Ампер', 'Ом'],
                correct: 'Ампер'
            },
            {
                text: 'Який закон описує відношення між силою, масою та прискоренням?',
                image: '',
                options: ['Закон Ома', 'Другий закон Ньютона', 'Закон Архімеда'],
                correct: 'Другий закон Ньютона'
            },
            {
                text: 'Що таке кінетична енергія?',
                image: '',
                options: ['Енергія руху', 'Енергія спокою', 'Енергія взаємодії'],
                correct: 'Енергія руху'
            },
            {
                text: 'Який елемент є основним компонентом сонячних батарей?',
                image: '',
                options: ['Кремній', 'Вуглець', 'Залізо'],
                correct: 'Кремній'
            },
            {
                text: 'Що вимірюється в Паскалях?',
                image: '',
                options: ['Тиск', 'Температура', 'Енергія'],
                correct: 'Тиск'
            },
            {
                text: 'Який закон пояснює взаємодію електричних зарядів?',
                image: '',
                options: ['Закон Кулона', 'Закон Бойля', 'Закон Фарадея'],
                correct: 'Закон Кулона'
            },
            {
                text: 'Який прилад використовується для вимірювання температури?',
                image: '',
                options: ['Термометр', 'Барометр', 'Манометр'],
                correct: 'Термометр'
            },
            {
                text: 'Як називається процес переходу рідини в газоподібний стан?',
                image: '',
                options: ['Конденсація', 'Випаровування', 'Сублімація'],
                correct: 'Випаровування'
            }
        ];

        function shuffleQuestions(array) {
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
        }

        shuffleQuestions(questions);

        let currentQuestionIndex = 0;
        let score = 0;

        function submitAnswer() {
            const selectedOption = document.querySelector('input[name="answer"]:checked');
            const feedback = document.getElementById('feedback');

            if (selectedOption) {
                const isCorrect = selectedOption.value === questions[currentQuestionIndex].correct;
                feedback.textContent = isCorrect ? 'Правильно!' : 'Неправильно!';
                feedback.className = `feedback ${isCorrect ? 'correct' : 'incorrect'}`;
                feedback.style.display = 'block';
                document.getElementById('next-button').style.display = 'block';
                if (isCorrect) {
                    score++;
                }
                document.querySelectorAll('input[name="answer"]').forEach(input => {
                    input.disabled = true;
                });
            }
        }

        function nextQuestion() {
            currentQuestionIndex++;
            if (currentQuestionIndex < questions.length) {
                document.getElementById('next-button').style.display = 'none';
                document.getElementById('feedback').style.display = 'none';
                loadQuestion();
            } else {
                showResult();
            }
        }

        function loadQuestion() {
            const question = questions[currentQuestionIndex];
            document.getElementById('question-number').innerText = `Питання ${currentQuestionIndex + 1}/${questions.length}`;
            document.getElementById('question-text').innerText = question.text;
            document.getElementById('label1').innerText = question.options[0];
            document.getElementById('label2').innerText = question.options[1];
            document.getElementById('label3').innerText = question.options[2];
            document.getElementById('option1').value = question.options[0];
            document.getElementById('option2').value = question.options[1];
            document.getElementById('option3').value = question.options[2];
            document.getElementById('quiz-form').reset();
            document.querySelectorAll('input[name="answer"]').forEach(input => {
                input.disabled = false;
            });
        }

        function showResult() {
            const result = document.getElementById('result');
            let rating;
            if (score >= 9) {
                rating = 'Ейнштейн';
            } else if (score >= 6) {
                rating = 'Фізик-аматор';
            } else {
                rating = 'Новачок у фізиці';
            }
            result.innerHTML = `<p>Ви завершили вікторину!</p>
                                        <p>Ваш рахунок: ${score} з ${questions.length}</p>
                                        <p>Ваш ранг: ${rating}</p>`;
            result.style.display = 'block';
        }

        loadQuestion();
    </script>
