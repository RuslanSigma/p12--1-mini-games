@page
@model ігри.Pages.kwiz5Model
@{
}
<div class="quiz-container">
    <h1>Тест на знавця аніме Бліч</h1>
    <h2 id="question-number">Питання 1/10</h2>
    <p class="question" id="question-text">Як звати головного героя аніме "Бліч"?</p>
    <img src="ichigo.jpg" alt="Ічіго" id="question-image">
    <form id="quiz-form">
        <div class="option-container">
            <div class="option">
                <input type="radio" id="option1" name="answer" value="Ічіго Куросаки">
                <label for="option1" id="label1">Ічіго Куросаки</label>
            </div>
            <div class="option">
                <input type="radio" id="option2" name="answer" value="Рукія Кучікі">
                <label for="option2" id="label2">Рукія Кучікі</label>
            </div>
            <div class="option">
                <input type="radio" id="option3" name="answer" value="Кісуке Урахара">
                <label for="option3" id="label3">Кісуке Урахара</label>
            </div>
        </div>
        <button type="button" onclick="submitAnswer()">Відповісти</button>
    </form>
    <div id="feedback" class="feedback"></div>
    <button type="button" id="next-button" style="display:none;" onclick="nextQuestion()">Далі</button>
    <div id="result" class="result" style="display:none;"></div>
</div>
<script>
    const questions = [
        {
            text: 'Як звати головного героя аніме "Бліч"?',
            image: 'data:image/jpeg;base64,',
            options: ['Ічіго Куросаки', 'Рукія Кучікі', 'Кісуке Урахара'],
            correct: 'Ічіго Куросаки'
        },
        {
            text: 'Що є головною зброєю Ічіго?',
            image: 'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSVH5iEXcCDnr8p0l72D37Q1siBGqwmw-mUeg&s',
            options: ['Занпакто', 'Катана', 'Банкай'],
            correct: 'Занпакто'
        },
        {
            text: 'Як звати капітана 6-го загону, старшого брата Рукії?',
            image: 'data:image/jpeg;base64,',
            options: ['Бякуя Кучікі', 'Заракі Кенпачі', 'Гін Ічімару'],
            correct: 'Бякуя Кучікі'
        },
        {
            text: 'Яка форма Ічіго відкривається при досягненні Банкая?',
            image: 'data:image/jpeg;base64,',
            options: ['Тенса Зангецу', 'Муґетсу', 'Занпакто'],
            correct: 'Тенса Зангецу'
        },
        {
            text: 'Як називається темна сторона Ічіго?',
            image: 'data:image/jpeg;base64,',
            options: ['Холлоу Ічіго', 'Васто Лорде', 'Аранкар'],
            correct: 'Холлоу Ічіго'
        },
        {
            text: 'Хто є лідером Еспади?',
            image: 'data:image/jpeg;base64,',
            options: ['Сосуке Айзен', 'Грімджо', 'Улькіорра'],
            correct: 'Сосуке Айзен'
        },
        {
            text: 'Яка зброя розкриває істинну форму після команд "банкай"?',
            image: 'data:image/jpeg;base64,',
            options: ['Занпакто', 'Шикай', 'Золото'],
            correct: 'Занпакто'
        },
        {
            text: 'Яке ім’я має кіт, що допомагає Ічіго та його друзям?',
            image: 'data:image/jpeg;base64,',
            options: ['Йоруічі Шіхоін', 'Урахара', 'Гін'],
            correct: 'Йоруічі Шіхоін'
        },
        {
            text: 'Яку техніку використовує Ічіго проти Айзена?',
            image: 'data:image/jpeg;base64,',
            options: ['Муґетсу', 'Занпакто', 'Тенса'],
            correct: 'Муґетсу'
        },
        {
            text: 'Як називається Занпакто Ічіго?',
            image: 'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcShA9ZKUkkJv7CwhOSXU_rB77tSm1hkwzUkUw&s',
            options: ['Зангецу', 'Соде но Шірайюкі', 'Хьорінмару'],
            correct: 'Зангецу'
        }
    ];

    let currentQuestionIndex = 0;
    let score = 0;

    function submitAnswer() {
        const selectedOption = document.querySelector('input[name="answer"]:checked');
        const feedback = document.getElementById('feedback');

        if (selectedOption) {
            const isCorrect = selectedOption.value === questions[currentQuestionIndex].correct;
            feedback.textContent = isCorrect ? 'Правильно!' : 'Неправильно!';
            feedback.className = `feedback ${isCorrect ? 'correct' : 'incorrect'}`;
            feedback.style.display = 'block';
            document.getElementById('next-button').style.display = 'block';
            if (isCorrect) {
                score++;
            }
            document.querySelectorAll('input[name="answer"]').forEach(input => {
                input.disabled = true;
            });
        }
    }

    function nextQuestion() {
        currentQuestionIndex++;
        if (currentQuestionIndex < questions.length) {
            document.getElementById('next-button').style.display = 'none';
            document.getElementById('feedback').style.display = 'none';
            loadQuestion();
        } else {
            showResult();
        }
    }

    function loadQuestion() {
        const question = questions[currentQuestionIndex];
        document.getElementById('question-number').innerText = `Питання ${currentQuestionIndex + 1}/${questions.length}`;
        document.getElementById('question-text').innerText = question.text;
        document.getElementById('question-image').src = question.image;
        document.getElementById('label1').innerText = question.options[0];
        document.getElementById('label2').innerText = question.options[1];
        document.getElementById('label3').innerText = question.options[2];
        document.getElementById('option1').value = question.options[0];
        document.getElementById('option2').value = question.options[1];
        document.getElementById('option3').value = question.options[2];
        document.getElementById('quiz-form').reset();
        document.querySelectorAll('input[name="answer"]').forEach(input => {
            input.disabled = false;
        });
    }

    function showResult() {
        const result = document.getElementById('result');
        let rating;
        if (score >= 9) {
            rating = 'Справжній фанат Бліча';
        } else if (score >= 6) {
            rating = 'Добрий знавець Бліча';
        } else {
            rating = 'Новачок у Блічі';
        }
        result.innerHTML = `<p>Ви завершили вікторину!</p>
                            <p>Ваш рахунок: ${score} з ${questions.length}</p>
                            <p>Ваш ранг: ${rating}</p>`;
        result.style.display = 'block';
        document.getElementById('quiz-form').style.display = 'none';
    }

    loadQuestion();
</script>
